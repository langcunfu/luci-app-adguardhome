#!/usr/bin/ucode
'use strict';

import { stat, open, popen, readfile, writefile, unlink, lsdir } from 'fs';
import { cursor } from 'uci';

function shellQuote(value) {
	return "'" + replace(value, /'/g, "'\\''") + "'";
}

function coreUpdateRunning() {
	// The kernel releases the lock even if the updater is killed.
	const result = system(['/usr/bin/flock', '-n', '-E', '2',
		'/var/lock/AdGuardHome-update.lock', '/bin/true'], 3000);
	if (result != 0 && result != 2)
		die('Unable to check core update lock');
	return result == 2;
}

return {
	'luci.adguardhome': {
		getRedirectStatus: {
			call: function() {
				const conf = cursor();
				function option(name, fallback) {
					const value = conf.get('AdGuardHome', 'AdGuardHome', name);
					return (type(value) == 'array' ? value[0] : value) || fallback;
				}
				const result = {
					mode: option('redirect', 'none'),
					enabled: option('enabled', '0') == '1',
					applied_mode: option('old_redirect', 'none'),
					applied_enabled: option('old_enabled', '0') == '1',
					binpath: option('binpath', '/usr/bin/AdGuardHome/AdGuardHome'),
					redirected: trim(readfile('/var/run/AdGredir') || '') == '1'
				};
				conf.unload('AdGuardHome');
				const lock = system(['/usr/bin/flock', '-n', '-E', '2',
					'/var/lock/AdGuardHome-redirect.lock', '/bin/true'], 3000);
				if (lock != 0 && lock != 2)
					die('Unable to check redirect status');
				result.busy = lock == 2;
				return result;
			}
		},
		getManualConfig: {
			call: function() {
				const conf = cursor();
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				conf.unload('AdGuardHome');

				const template = readfile('/usr/share/AdGuardHome/AdGuardHome_template.yaml') || '';
				const current = readfile(configpath);
				if (current != null)
					return { content: current, template: template, source: 'current' };
				if (stat(configpath) != null)
					return { content: '', template: template, source: 'error' };
				return {
					content: template,
					template: template,
					source: template ? 'template' : 'missing'
				};
			}
		},
		setManualConfig: {
			args: { content: '' },
			call: function(request) {
				const content = request.args.content;
				if (content == null)
					return { saved: false, reason: 'invalid_content' };

				const conf = cursor();
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				const binpath = conf.get('AdGuardHome', 'AdGuardHome', 'binpath') ||
					'/usr/bin/AdGuardHome/AdGuardHome';
				conf.unload('AdGuardHome');

				const temporaryConfig = '/tmp/AdGuardHometmpconfig.yaml';
				const validationLog = '/tmp/AdGuardHometest.log';
				if (writefile(temporaryConfig, replace(content, /\r\n/g, '\n')) == null)
					return { saved: false, reason: 'write_failed' };

				if (stat(binpath)?.type == 'file') {
					const valid = system(['/bin/sh', '-c', '"$1" -c "$2" --check-config > "$3" 2>&1',
						'sh', binpath, temporaryConfig, validationLog], 30000) == 0;
					if (!valid)
						return { saved: false, reason: 'validation_failed', log: readfile(validationLog) || '' };
				}

				if (writefile(configpath, readfile(temporaryConfig) || '') == null)
					return { saved: false, reason: 'save_failed' };
				unlink(temporaryConfig);
				if (system(['/etc/init.d/AdGuardHome', 'reload'], 30000) != 0)
					return { saved: false, reason: 'reload_failed' };
				return { saved: true };
			}
		},
		getInterfaces: {
			call: function() {
				return { interfaces: lsdir('/sys/class/net') || [] };
			}
		},
		getCoreInfo: {
			call: function() {
				const conf = cursor();
				const binpath = conf.get('AdGuardHome', 'AdGuardHome', 'binpath') ||
					'/usr/bin/AdGuardHome/AdGuardHome';
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				const result = {
					core_exists: stat(binpath)?.type == 'file',
					config_exists: stat(configpath)?.type == 'file',
					version: null
				};

				if (result.core_exists) {
					// Pass the configured path as a positional argument; capture both output streams.
					const proc = popen('/bin/sh -c \'"$1" --version 2>&1\' sh ' + shellQuote(binpath), 'r');
					if (proc) {
						const output = proc.read('all') || '';
						proc.close();
						result.version = match(output, /version ([^, \t\r\n]+)/)?.[1] || null;
					}
				}

				conf.unload('AdGuardHome');
				return result;
			}
		},
		getCoreUpdate: {
			call: function() {
				const running = coreUpdateRunning();
				const failed = stat('/var/run/update_core_error') != null ||
					(!running && stat('/var/run/update_core') != null);
				const log = readfile('/tmp/AdGuardHome_update.log', 131072) || '';

				return {
					state: running ? 'running' : failed ? 'failure' : log ? 'finished' : 'idle',
					log: log
				};
			}
		},
		startCoreUpdate: {
			args: { force: false },
			call: function(request) {
				if (coreUpdateRunning())
					return { started: false, reason: 'busy' };

				const command = request.args.force
					? '/bin/sh /usr/share/AdGuardHome/update_core.sh force >/dev/null 2>&1 </dev/null &'
					: '/bin/sh /usr/share/AdGuardHome/update_core.sh >/dev/null 2>&1 </dev/null &';

				return { started: system(['/bin/sh', '-c', command], 3000) == 0 };
			}
		},
		changeWebPassword: {
			args: { hash: '' },
			call: function(request) {
				const hash = request.args.hash;
				if (!match(hash, /^\$2[aby]\$(0[4-9]|[12][0-9]|3[01])\$[.\/A-Za-z0-9]{53}$/))
					return { changed: false, reason: 'invalid_hash' };

				const conf = cursor();
				const configpath = conf.get('AdGuardHome', 'AdGuardHome', 'configpath') ||
					'/etc/AdGuardHome.yaml';
				if (stat(configpath)?.type != 'file')
					return { changed: false, reason: 'no_config' };

				if (!conf.set('AdGuardHome', 'AdGuardHome', 'hashpass', hash) ||
					!conf.commit('AdGuardHome'))
					return { changed: false, reason: 'save_failed' };
				conf.unload('AdGuardHome');

				if (system(['/etc/init.d/AdGuardHome', 'reload'], 30000) != 0)
					return { changed: false, reason: 'reload_failed' };

				if (index(readfile(configpath) || '', hash) < 0)
					return { changed: false, reason: 'verify_failed' };
				return { changed: true };
			}
		},
		setVerboseLog: {
			args: { enabled: false },
			call: function(request) {
				const conf = cursor();
				if (!conf.set('AdGuardHome', 'AdGuardHome', 'verbose', request.args.enabled ? '1' : '0') ||
					!conf.commit('AdGuardHome'))
					return { saved: false, applied: false };
				conf.unload('AdGuardHome');
				return {
					saved: true,
					applied: system(['/etc/init.d/AdGuardHome', 'reload'], 30000) == 0
				};
			}
		},
		getRuntimeLog: {
			args: { offset: 0, identity: '' },
			call: function(request) {
				const conf = cursor();
				const logfile = conf.get('AdGuardHome', 'AdGuardHome', 'logfile') || '';
				conf.unload('AdGuardHome');
				if (!logfile)
					return { enabled: false, localtime: false, content: '', offset: 0 };

				let source = logfile;
				if (logfile == 'syslog') {
					source = '/tmp/AdGuardHometmp.log';
					writefile('/var/run/AdGuardHomesyslog', '1');
					if (stat(source)?.type != 'file')
						system(['/bin/sh', '-c', '/bin/sh /usr/share/AdGuardHome/getsyslog.sh >/dev/null 2>&1 &'], 3000);
				}

				// Bound memory and start with the most recent 256 KiB on a new view.
				const limit = 262144;
				const info = stat(source);
				const identity = info ? source + ':' + info.dev.major + ':' + info.dev.minor + ':' + info.inode : '';
				let offset = int(request.args.offset) || 0;
				let reset = request.args.identity != identity || offset < 0 || offset > (info?.size || 0);
				if (reset)
					offset = 0;
				if (info && info.size - offset > limit) {
					offset = info.size - limit;
					reset = true;
				}

				let content = '';
				if (info?.type == 'file') {
					const file = open(source, 'r');
					if (!file)
						die('Unable to open runtime log');
					const positioned = file.seek(offset);
					const chunk = positioned ? file.read(limit) : null;
					file.close();
					if (chunk == null)
						die('Unable to read runtime log');
					content = chunk;
				}

				return {
					enabled: true,
					localtime: logfile != 'syslog',
					// ubus strings stop at NUL; cleared files can contain sparse zero-filled gaps.
					content_b64: b64enc(content),
					offset: offset + length(content),
					identity: identity,
					reset: reset
				};
			}
		},
		clearRuntimeLog: {
			call: function() {
				const conf = cursor();
				const logfile = conf.get('AdGuardHome', 'AdGuardHome', 'logfile') || '';
				conf.unload('AdGuardHome');
				if (!logfile)
					return { cleared: false, reason: 'no_logfile' };

				const source = logfile == 'syslog' ? '/tmp/AdGuardHometmp.log' : logfile;
				return { cleared: writefile(source, '') != null };
			}
		}
	}
};